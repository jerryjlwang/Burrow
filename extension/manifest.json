{
  "manifest_version": 3,
  "name": "Wonderland",
  "version": "0.1.0",
  "description": "A pixel-art White Rabbit that lives on the page. Kids teach it in their own words, and it asks, forgets, and learns.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "offscreen",
    "contextMenus",
    "topSites",
    "favicon"
  ],
  "host_permissions": [
    "http://localhost:8787/*",
    "http://127.0.0.1:8787/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Wonderland",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "onboarding.html",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-companion": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Open or close the rabbit's panel"
    },
    "toggle-voice": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Start or stop voice mode"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "characters/*",
        "ui/*",
        "fonts/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
