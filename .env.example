# ---- Secrets (server-side only; never bundled into the extension) ----
DEEPGRAM_API_KEY=
LLM_API_KEY=

# ---- LLM ----
# Provider: openai | mock  (mock = deterministic rule-based agent, no key needed).
# If omitted, an sk-… key selects openai and no key falls back to mock.
LLM_PROVIDER=openai
# Default: gpt-6-astra
LLM_MODEL=gpt-6-astra
# Reasoning effort for the companion's turn decisions: none | minimal | low | medium | high
# (gpt-5.4 uses "none" for fastest replies, older gpt-5 models call it "minimal", gpt-6-astra bottoms out at "low" — the server adapts automatically)
LLM_EFFORT=none

# ---- Deepgram voice (non-secret defaults) ----
DEEPGRAM_TTS_MODEL=flux-rufus-en
DEEPGRAM_TTS_SPEED=1
DEEPGRAM_TTS_EXPRESSIVITY=0
DEEPGRAM_STT_MODEL=flux-general-en
# Flux reports when a turn has PROBABLY ended ~0.4s before it is sure; the rabbit starts deciding
# on that early signal and keeps the result only if the final words match. 0.3–0.7; lower = earlier
# but more discarded guesses (cost only, never behaviour). 0 turns it off.
DEEPGRAM_EAGER_EOT=0.4

# ---- Server ----
PORT=8787
# Set to 1 to force demo-friendly deterministic behaviour even when an LLM key is present
DEMO_MODE=0

# ---- Tablet watcher (Alt+Shift+D) ----
# Secret. Gemini key for judging the kid's rough work on the tablet. Without it the judge runs a scripted mock.
GEMINI_API_KEY=
# Vision model for the judge; must return JSON and accept thinkingLevel (gemini-3.x flash models do).
INK_MODEL=gemini-3.8-flash

# Optional: lets the rabbit read along with YouTube videos (transcripts via supadata.ai — never YouTube's own endpoints).
# Without it, watching along only works on pages whose <video> carries its own captions.
SUPADATA_API_KEY=
